# ===========================================================================
# Beyond Orbit — local environment template.
#
#   cp .env.example .env      then fill in the values below.
#
# On GitHub Actions you do NOT use this file — add the same names under
#   Settings -> Secrets and variables -> Actions -> New repository secret
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED for uploading to YouTube
# ---------------------------------------------------------------------------
# Create a Google Cloud project -> enable "YouTube Data API v3" -> create an
# OAuth client ID of type "Desktop app". Then generate a refresh token for the
# Beyond Orbit channel (see README section 4 — make sure you pick the RIGHT
# channel in the account chooser, not FactVault or your personal channel).
#
# IMPORTANT: publish the OAuth consent screen to "In production". While it is
# left in "Testing" mode Google expires the refresh token after 7 days, which
# silently breaks the pipeline every week.
YT_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YT_CLIENT_SECRET=your_oauth_client_secret
YT_REFRESH_TOKEN=your_refresh_token_for_the_beyond_orbit_channel

# Optional alternatives to the three values above (either is enough):
#   YT_CLIENT_SECRET_JSON = the entire contents of client_secret.json
#   YT_TOKEN_JSON         = the entire contents of a youtube_token.json you
#                           generated locally once
# YT_CLIENT_SECRET_JSON=
# YT_TOKEN_JSON=

# ---------------------------------------------------------------------------
# OPTIONAL — script quality
# ---------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it the pipeline still works: scripts are built from the beat
# templates in topics/space_bank.json. With it, each run writes a fresh
# documentary script from the bank entry as a brief (much better variety, and
# it avoids YouTube's "inauthentic / mass-produced content" flag).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# OPTIONAL — extra B-roll
# ---------------------------------------------------------------------------
# NASA SVS + images-api.nasa.gov need NO key and are the primary footage source.
# Pexels is only used as a filler when NASA returns too few usable assets.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — overrides (normally leave these alone; set them in config.json)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# YOUTUBE_PRIVACY=private          # force privacy for a test run
# BO_RESOLUTION=1440p              # 1080p | 1440p | 4k  (overrides config.json)
# YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# YOUTUBE_TOKEN_FILE=youtube_token.json
